  <ProjectScript><![CDATA[Chaser.Cd = 0.0;
Starlink.Cd = 0.0;
View Starlink, Chaser;
While (Chaser.ElapsedTime < TIMESPAN(20099 seconds));
Step Chaser;
Step Starlink;
Update ViewWindow1;
End;
Step Chaser to (Chaser.ElapsedTime == TIMESPAN(0.251156 seconds));
Step Starlink to (Starlink.Epoch == Chaser.Epoch);
Maneuver Chaser using delta_v1 generating "G:\Il mio Drive\UNIVERSITÀ\TESI TRIENNALE\Active-Debris-Removal-Bachelor-Thesis\FREEFLYER SIMULATION\Risultati\B_NRLMSISE_scenari\chaser_150kg_moderata\1_Burn1_partenza_phasing_da_400km.txt";
While (Chaser.ElapsedTime < TIMESPAN(2760 seconds));
Step Chaser;
Step Starlink;
Update ViewWindow1;
End;
Step Chaser to (Chaser.OrbitApoapsis);
Step Starlink to (Starlink.Epoch == Chaser.Epoch);
Update ViewWindow1;
Report Chaser.Height<14,7>;
Maneuver Chaser using delta_v2 generating "G:\Il mio Drive\UNIVERSITÀ\TESI TRIENNALE\Active-Debris-Removal-Bachelor-Thesis\FREEFLYER SIMULATION\Risultati\B_NRLMSISE_scenari\chaser_150kg_moderata\2_Burn2_arrivo_550km_rendezvous.txt";
Variable dr;
Variable dv;
dr = Chaser.Range(Starlink)*1000;
dv = sqrt((Chaser.VX-Starlink.VX)^2 + (Chaser.VY-Starlink.VY)^2 + (Chaser.VZ-Starlink.VZ)^2)*100000;
Report dr<14,7>, dv<14,7> to "G:\Il mio Drive\UNIVERSITÀ\TESI TRIENNALE\Active-Debris-Removal-Bachelor-Thesis\FREEFLYER SIMULATION\Risultati\B_NRLMSISE_scenari\chaser_150kg_moderata\Cattura.txt";
If (dr > 1 or dv > 1);
    Report "Cattura non riuscita";
    Stop;
End;
Variable mC;
Variable mT;
mC = Chaser.MassTotal;
mT = Starlink.MassTotal;
Chaser.X  = (mC*Chaser.X  + mT*Starlink.X )/(mC+mT);
Chaser.Y  = (mC*Chaser.Y  + mT*Starlink.Y )/(mC+mT);
Chaser.Z  = (mC*Chaser.Z  + mT*Starlink.Z )/(mC+mT);
Chaser.VX = (mC*Chaser.VX + mT*Starlink.VX)/(mC+mT);
Chaser.VY = (mC*Chaser.VY + mT*Starlink.VY)/(mC+mT);
Chaser.VZ = (mC*Chaser.VZ + mT*Starlink.VZ)/(mC+mT);
Starlink.X = Chaser.X;
Starlink.Y = Chaser.Y;
Starlink.Z = Chaser.Z;
Starlink.VX = Chaser.VX;
Starlink.VY = Chaser.VY;
Starlink.VZ = Chaser.VZ;
Chaser.MassTotal = Chaser.MassTotal + Starlink.MassTotal;
Starlink.MassTotal = Chaser.MassTotal;
Chaser.DragArea = 5.5;
Starlink.DragArea = 5.5;
Chaser.Cd = 2.2;
Starlink.Cd = 2.2;
While (Chaser.ElapsedTime < TIMESPAN(3000 seconds));
Step Chaser;
Step Starlink;
Update ViewWindow1;
End;
Maneuver Chaser using delta_v3 generating "G:\Il mio Drive\UNIVERSITÀ\TESI TRIENNALE\Active-Debris-Removal-Bachelor-Thesis\FREEFLYER SIMULATION\Risultati\B_NRLMSISE_scenari\chaser_150kg_moderata\4_Burn3_deorbiting_perigeo_200km.txt";
Starlink.VX = Chaser.VX;
Starlink.VY = Chaser.VY;
Starlink.VZ = Chaser.VZ;
Starlink.MassTotal = Chaser.MassTotal;
While (Starlink.Height > 110 and Starlink.ElapsedTime < TIMESPAN(120 days));
Step Starlink;
Step Chaser;
Update ViewWindow1;
End;
Step Starlink to (Starlink.Height == 100);
Step Chaser to (Chaser.Epoch == Starlink.Epoch);
Update ViewWindow1;
Report Starlink.Height<14,7>;
Report Starlink.Epoch<14,7> to "G:\Il mio Drive\UNIVERSITÀ\TESI TRIENNALE\Active-Debris-Removal-Bachelor-Thesis\FREEFLYER SIMULATION\Risultati\B_NRLMSISE_scenari\chaser_150kg_moderata\Starlink Epoch.txt";]]></ProjectScript>
